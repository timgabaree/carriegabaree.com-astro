---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {readArchive} from '../../../scripts/archive-data.mjs';
import '../../styles/archive-search.css';
import {sourceLink} from '../../../public/js/archive-matches.js';
type ArchiveRecord={id:string;title:string;kind:string;summary:string;sourceUrl:string;subjects:string[];segments:{locator:string;content:string}[]};
interface Props {records:ArchiveRecord[];record:ArchiveRecord|null;}
export function getStaticPaths(){
 const records=readArchive();
 return [{params:{slug:undefined},props:{records,record:null}},...records.map((record:ArchiveRecord)=>({params:{slug:record.id},props:{records:[],record}}))];
}
const {records,record}=Astro.props;
const path=record?'/search/'+record.id:'/search';
const preview=process.env.ARCHIVE_PREVIEW==='1';
---
<BaseLayout title={(record?record.title:'Search')+' | Carrie Gabaree'} description="Explore oral histories, publications and archival materials." path={path} mainClass="site" noindex={preview}>
 <article class="page-panel archive-page">
  {preview&&<p class="archive-preview-note">Local preview — only website-approved records are included. This view does not publish changes to the live site.</p>}
  {record?<>
   <nav class="archive-record-controls" aria-label="Archive reading controls">
    <a id="archive-back" class="button button-secondary" href="/search">← Back to search results</a>
    <button id="archive-show-full" class="button button-secondary" type="button" aria-controls="archive-source-text" aria-pressed="false" hidden>Show full document</button>
   </nav>
   <p class="eyebrow">{record.kind}</p><h1>{record.title}</h1>
   <p class="page-intro">{record.summary}</p>
   {record.subjects.length>0&&<p class="archive-subjects"><strong>Subjects:</strong> {record.subjects.join(' · ')}</p>}
   {record.sourceUrl&&<p><a class="button button-secondary" href={record.sourceUrl}>View original on Carrie’s website</a></p>}
   <section id="archive-matches" hidden aria-labelledby="search-matches">
    <h2 id="search-matches" tabindex="-1">Matching passages</h2>
    <p id="archive-match-status" role="status"></p>
    <div id="archive-match-list" class="archive-results"></div>
    <button id="archive-match-more" type="button" class="button button-secondary" hidden>Show more matching passages</button>
   </section>
   <section id="archive-source-text" aria-labelledby="archive-source-heading">
   <h2 id="archive-source-heading">Source text</h2>
   <p id="archive-source-status" role="status" hidden></p>
   {record.segments.length?record.segments.map((s:{locator:string;content:string},i:number)=>{const source=sourceLink(record.sourceUrl,s.locator);return <section class="archive-passage" tabindex="-1" id={'passage-'+(i+1)}><h3>{s.locator||'Passage '+(i+1)}</h3><p>{s.content}</p>{source&&<a class="archive-source-link" href={source.href}>{source.label}</a>}</section>}):<p>No transcript or publication text is attached to this record.</p>}
   </section>
  </>:<>
   <p class="eyebrow">Publications & oral histories</p><h1>Search</h1>
   <p class="page-intro">Find stories, people and subjects across oral histories, publications and their full text.</p>
   {records.length===0?<div class="archive-empty"><h2>No records available yet</h2><p>Please check back as the collection grows.</p></div>:<>
    <form id="archive-search-form" role="search" data-record-count={records.length}>
     <div><label for="archive-query">Search the collection</label><input id="archive-query" type="search" maxlength="200" placeholder="Enter a topic, name or phrase" autocomplete="off" /></div>
     <div><label for="archive-type">Material type</label><select id="archive-type"><option value="">All types</option>{[...new Set(records.map((r:{kind:string})=>r.kind))].map(kind=><option value={kind}>{kind}</option>)}</select></div>
     <button class="button" type="submit">Search</button><button class="button button-secondary" type="reset">Clear</button>
     <details id="archive-advanced"><summary>Advanced search</summary>
      <p>Use the main search box for <strong>all these words (AND)</strong>. Add optional conditions below. Word searches include endings such as “bombing” for “bomb”; phrases match the words as written, ignoring case and extra spaces. Type words, not AND/OR operators.</p>
      <div class="archive-advanced-fields">
       <div><label for="archive-any">Any of these words (OR)</label><input id="archive-any" maxlength="200" placeholder="e.g. museum collection" /></div>
       <div><label for="archive-phrase">Exact phrase</label><input id="archive-phrase" maxlength="200" placeholder="e.g. body armor" /></div>
       <div><label for="archive-exclude">Exclude these words (NOT)</label><input id="archive-exclude" maxlength="200" placeholder="e.g. training" /></div>
       <div><label for="archive-scope">Search within</label><select id="archive-scope" aria-describedby="archive-scope-help"><option value="passage">Same passage</option><option value="document">Same document</option><option value="site">Entire site</option></select></div>
      </div>
      <p id="archive-scope-help">Same passage: all conditions must match one transcript segment or PDF page. Same document: words may occur in different passages; exclusions apply to the whole record. Entire site: also includes ordinary website pages, with conditions matched within each page or document. Exact phrases never span passages. Material type still limits results.</p>
      <button class="button" type="submit">Search with these options</button>
     </details>
    </form>
    <p id="archive-search-status" role="status" aria-live="polite">Browse all {records.length} records below, or search their full text.</p>
    <div id="archive-results" class="archive-results"></div>
    <button id="archive-more" class="button button-secondary" type="button" hidden>Show more results</button>
    <details id="archive-browse" open><summary>Browse all records</summary><ul class="archive-record-list">{records.map((r:{id:string;title:string;kind:string;summary:string})=><li><h2><a href={'/search/'+r.id}>{r.title}</a></h2><p class="eyebrow">{r.kind}</p><p>{r.summary}</p></li>)}</ul></details>
    <noscript><p>Keyword search needs JavaScript. You can still browse every record above.</p></noscript>
   </>}
  </>}
 </article>
<script is:inline type="module" src="/js/archive-search.js"></script>
{record&&<script is:inline type="module" src="/js/archive-record.js"></script>}
</BaseLayout>
