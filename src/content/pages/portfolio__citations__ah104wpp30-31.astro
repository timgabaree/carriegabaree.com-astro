---
import PageHeader from '../../components/PageHeader.astro';
import CitationCard from '../../components/CitationCard.astro';
---
<article class="page-panel citation-page">
  <PageHeader class="page-header">
    <p class="eyebrow">Publication Citation</p>
    <h1> “A New Helmet for a New Army: The Development of an American Helmet
      During World War I” </h1>
    <p class="page-intro"> Citation information for Carrie Gabaree’s article in <cite>Army History</cite>, no. 104, Summer 2017, pages 30–31. </p>
  </PageHeader>
  <section class="citation-summary">
    <p class="publication-meta">Army History · No. 104 · Summer 2017</p>
    <p> Carrie Gabaree examines the development of American protective helmets
      during World War I. </p>
  </section>
  <div class="citation-list">
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>Chicago</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="ah104-chicago"> Copy citation </button>
      </div>
      <p id="ah104-chicago" class="citation-text"> Gabaree, Carrie. “A New Helmet for a New Army: The Development of an
        American Helmet During World War I.” <cite>Army History</cite>,
        no. 104 (Summer 2017): 30–31. </p>
    </CitationCard>
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>MLA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="ah104-mla"> Copy citation </button>
      </div>
      <p id="ah104-mla" class="citation-text"> Gabaree, Carrie. “A New Helmet for a New Army: The Development of an
        American Helmet During World War I.” <cite>Army History</cite>,
        no. 104, Summer 2017, pp. 30–31. </p>
    </CitationCard>
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>APA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="ah104-apa"> Copy citation </button>
      </div>
      <p id="ah104-apa" class="citation-text"> Gabaree, C. (2017). A new helmet for a new army: The development of
        an American helmet during World War I. <cite>Army History</cite>,
        (104), 30–31. </p>
    </CitationCard>
  </div>
