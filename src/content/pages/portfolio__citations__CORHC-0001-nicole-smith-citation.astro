---
import PageHeader from '../../components/PageHeader.astro';
import CitationCard from '../../components/CitationCard.astro';
---
<article class="page-panel citation-page">
  <PageHeader class="page-header">
    <p class="eyebrow">Oral History Citation</p>
    <h1>Nicole Smith Oral History</h1>
    <p class="page-intro">
      Citation information for the oral-history interview with
      Nicole Smith, conducted by Andrew Woods
      with Carrie Gabaree (Tarasuk)
      at First Division Museum at Cantigny, Wheaton, Illinois on October 21, 2005.
    </p>
  </PageHeader>

  <section class="citation-summary">
    <p class="publication-meta">
      Oral history · CORHC-0001 · October 21, 2005 · Runtime: 1:58:31
    </p>
    <p>
      <strong>Interviewee:</strong> Nicole Smith<br />
      <strong>Interviewer:</strong> Andrew Woods<br />
      <strong>Additional participant:</strong> Carrie Gabaree (Tarasuk)<br />
      <strong>Repository:</strong> Carrie Gabaree Digital Archive
    </p>
  </section>

  <div class="citation-list">

    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>Chicago</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="corhc-0001-chicago"> Copy citation </button>
      </div>
      <p id="corhc-0001-chicago" class="citation-text">
        Smith, Nicole. Interview by Andrew Woods. October 21, 2005. CORHC-0001, Carrie Gabaree Digital Archive. https://carriegabaree.com/portfolio/oralhistories/CORHC-0001-nicole-smith.html.
      </p>
    </CitationCard>

    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>MLA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="corhc-0001-mla"> Copy citation </button>
      </div>
      <p id="corhc-0001-mla" class="citation-text">
        Smith, Nicole. Interview by Andrew Woods. <cite>Carrie Gabaree Digital Archive</cite>, October 21, 2005, https://carriegabaree.com/portfolio/oralhistories/CORHC-0001-nicole-smith.html.
      </p>
    </CitationCard>

    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>APA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="corhc-0001-apa"> Copy citation </button>
      </div>
      <p id="corhc-0001-apa" class="citation-text">
        Smith, N. (2005, October 21). <cite>Nicole Smith Oral History</cite> [Oral history interview by Andrew Woods]. Carrie Gabaree Digital Archive. https://carriegabaree.com/portfolio/oralhistories/CORHC-0001-nicole-smith.html
      </p>
    </CitationCard>

  </div>

  <aside class="citation-note">
    <h2>Oral-history citation note</h2>
    <p>
      Oral-history citation practices vary by style guide and institution.
      These citations identify the interviewee or interviewees, interviewer,
      interview date, archival identifier, repository, and stable interview
      page so researchers can locate the audiovisual recording and transcript.
    </p>
  </aside>

  <div class="button-group citation-actions">
    <a class="button button-primary" href="/portfolio/oralhistories/CORHC-0001-nicole-smith">
      View oral history
    </a>
    <a class="button button-secondary" href="/portfolio/oralhistories/CORHC-0001-nicole-smith-transcript">
      Read transcript
    </a>
    <a class="button button-secondary" href="/oral-histories">
      Back to oral histories
    </a>
  </div>

  <p class="citation-disclaimer">
    Citations are provided for convenience. Requirements may vary by
    institution, publisher, instructor, repository, or edition of a style guide.
  </p>
</article>
