---
import PageHeader from '../../components/PageHeader.astro';
import ContentCard from '../../components/ContentCard.astro';
---
<article class="page-panel">
    <PageHeader class="page-header">
      <p class="eyebrow">Documenting Lived Experience</p>
      <h1>Oral Histories</h1>
      <p class="publication-meta">
  Oral-history interviews, transcripts, and preservation records from the
  Carrie Gabaree Digital Archive.
</p>
      <br />
      <p class="page-intro">
        Oral history preserves personal experience in the voices of the
        people who lived it. This collection reflects Carrie Gabaree’s public-history work in
        historical research, interviewing, documentation, interpretation,
        and the responsible stewardship of stories for future generations.
      </p>
    </PageHeader>

    <div class="content-list">


<ContentCard class="content-card oral-history-card">

  <h2>Nicole Smith Oral History — October 21, 2005</h2>

  <p>
    Oral-history interview with Nicole Smith, conducted by Andrew Woods
    with Carrie Gabaree (Tarasuk), at the First Division Museum at Cantigny
    in Wheaton, Illinois.
  </p>

  <p class="publication-meta">
    Identifier: CORHC-0001<br />
    Interview date: October 21, 2005<br />
    Runtime: 1:58:31
  </p>

  <div class="oral-history-media-actions">

    <div class="oral-history-media-item">

      <a href="/portfolio/oralhistories/CORHC-0001-nicole-smith" aria-label="View Nicole Smith oral history">
        <img class="oral-history-thumbnail" src="https://customer-txz6xqq5qm2ofi03.cloudflarestream.com/2d5e83fa289412c2c16cfbdc447921eb/thumbnails/thumbnail.jpg" alt="Nicole Smith during her October 21, 2005 oral-history interview" width="200" height="150" loading="lazy" />
      </a>

      <a class="button button-secondary" href="/portfolio/oralhistories/CORHC-0001-nicole-smith">
        View oral history
      </a>

    </div>

<div class="oral-history-media-item">

  <a href="/portfolio/citations/CORHC-0001-nicole-smith-citation" aria-label="View citation information for the Nicole Smith oral history">

    <img src="/media/oral-history-citation-200x150.webp" alt="Oral history citation document icon" width="200" height="150" loading="lazy" />

  </a>

  <a class="button button-secondary" href="/portfolio/citations/CORHC-0001-nicole-smith-citation">

    Cite oral history

  </a>

</div>

  </div>

</ContentCard>



