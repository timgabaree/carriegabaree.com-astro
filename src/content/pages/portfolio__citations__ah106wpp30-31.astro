---
import PageHeader from '../../components/PageHeader.astro';
import CitationCard from '../../components/CitationCard.astro';
---
<article class="page-panel citation-page">
  <PageHeader class="page-header">
    <p class="eyebrow">Publication Citation</p>
    <h1> “Protecting the Doughboys: The Development of American Body Armor
      During World War I” </h1>
    <p class="page-intro"> Citation information for Carrie Gabaree’s article in <cite>Army History</cite>, no. 106, Winter 2018, pages 30–31. </p>
  </PageHeader>
  <section class="citation-summary">
    <p class="publication-meta">Army History · No. 106 · Winter 2018</p>
    <p> Carrie Gabaree examines the development of experimental American body
      armor during World War I. </p>
  </section>
  <div class="citation-list">
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>Chicago</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="ah106-chicago"> Copy citation </button>
      </div>
      <p id="ah106-chicago" class="citation-text"> Gabaree, Carrie. “Protecting the Doughboys: The Development of
        American Body Armor During World War I.” <cite>Army History</cite>,
        no. 106 (Winter 2018): 30–31. </p>
    </CitationCard>
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>MLA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="ah106-mla"> Copy citation </button>
      </div>
      <p id="ah106-mla" class="citation-text"> Gabaree, Carrie. “Protecting the Doughboys: The Development of
        American Body Armor During World War I.” <cite>Army History</cite>,
        no. 106, Winter 2018, pp. 30–31. </p>
    </CitationCard>
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>APA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="ah106-apa"> Copy citation </button>
      </div>
      <p id="ah106-apa" class="citation-text"> Gabaree, C. (2018). Protecting the doughboys: The development of
        American body armor during World War I. <cite>Army History</cite>,
        (106), 30–31. </p>
    </CitationCard>
  </div>
<div class="publication-media-actions">

  <div class="publication-media-item">
    <a href="/portfolio/armypubs/AH106W.pdf" target="_blank" rel="noopener noreferrer" aria-label="View Army History No. 106 full issue">
      <img src="/media/AH106W-cover-200x257.webp" alt="Cover of Army History, No. 106, Winter 2018" width="200" height="257" loading="lazy" />
    </a>

    <a class="button button-secondary" href="/portfolio/armypubs/AH106W.pdf" target="_blank" rel="noopener noreferrer">
      View full issue
    </a>
  </div>

  <div class="publication-media-item">
    <a href="/portfolio/armypubs/AH106Wpp30-31.pdf" target="_blank" rel="noopener noreferrer" aria-label="Read Protecting the Doughboys article">
      <img src="/media/AH106W-p30-200x257.webp" alt="First page of Protecting the Doughboys: The Development of American Body Armor During World War I" width="200" height="257" loading="lazy" />
    </a>

    <a class="button button-secondary" href="/portfolio/armypubs/AH106Wpp30-31.pdf" target="_blank" rel="noopener noreferrer">
      Read article
    </a>
  </div>

<div class="publication-media-item">
  <a href="/publications" aria-label="Back to publications">
    <img src="/media/return-to-publications-200x257.webp" alt="Return to publications icon" width="200" height="257" loading="lazy" />
  </a>

  <a class="button button-secondary" href="/publications">
    Back to publications
  </a>
</div>

</div>
  <p class="citation-disclaimer"> Citations are provided for convenience. Requirements may vary by
    institution, publisher, instructor, or edition of a style guide. </p>
</article>
