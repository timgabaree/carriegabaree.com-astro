---
import PageHeader from '../../components/PageHeader.astro';
import CitationCard from '../../components/CitationCard.astro';
---
<article class="page-panel citation-page">
  <PageHeader class="page-header">
    <p class="eyebrow">Publication Citation</p>
    <h1><cite>The Great War: U.S. Army Artifacts</cite></h1>
    <p class="page-intro"> Citation information for <cite>The Great War: U.S. Army Artifacts</cite>,
      published by the Center of Military History, United States Army, in 2018.
      Carrie M. Gabaree is one of the publication’s contributing authors. </p>
  </PageHeader>
  <section class="citation-summary">
    <p class="publication-meta">Book contribution · CMH Pub 70-128 · 2018</p>
    <p> General editor Sarah G. Forgey. Contributions by Alan T. Bogan,
      Carrie M. Gabaree, Paul M. Miller, and Brian F. Neumann.
      Photography by Pablo Jimenez-Reyes. </p>
  </section>
  <div class="citation-list">
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>Chicago</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="cmh-chicago"> Copy citation </button>
      </div>
      <p id="cmh-chicago" class="citation-text"> Forgey, Sarah G., ed. <cite>The Great War: U.S. Army Artifacts</cite>.
        Contributions by Alan T. Bogan, Carrie M. Gabaree, Paul M. Miller,
        and Brian F. Neumann. Washington, DC: Center of Military History,
        United States Army, 2018. </p>
    </CitationCard>
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>MLA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="cmh-mla"> Copy citation </button>
      </div>
      <p id="cmh-mla" class="citation-text"> Forgey, Sarah G., general editor. <cite>The Great War: U.S. Army
        Artifacts</cite>. Contributions by Alan T. Bogan, Carrie M. Gabaree,
        Paul M. Miller, and Brian F. Neumann, Center of Military History,
        United States Army, 2018. </p>
    </CitationCard>
    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>APA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="cmh-apa"> Copy citation </button>
      </div>
      <p id="cmh-apa" class="citation-text"> Forgey, S. G. (Ed.). (2018). <cite>The great war: U.S. Army
        artifacts</cite>. Center of Military History, United States Army. </p>
    </CitationCard>
  </div>
  <aside class="citation-note">
    <h2>Contributor information</h2>
    <p> Carrie M. Gabaree is credited as a contributor to the complete work.
      Standard citation styles generally identify the editor of an edited
      volume rather than listing every contributor. The expanded Chicago and
      MLA citations above retain the contributor information to document
      Carrie’s role. </p>
  </aside>
