---
import PageHeader from '../../components/PageHeader.astro';
import ContentCard from '../../components/ContentCard.astro';
---
<div class="publications-page">
  <article class="page-panel">
    <PageHeader class="page-header">
      <p class="eyebrow">Research and Scholarship</p>
      <h1>Publications</h1>
      <p class="page-intro"> Selected publications and contributions concerning United States
        Army material culture, military equipment, and the experience of
        American soldiers during World War I. </p>
    </PageHeader>
    <div class="content-list">
  <ContentCard class="content-card" id="great-war">

  <p class="publication-meta">
    Book contribution · 2018
  </p>

  <h2>
    <cite>The Great War: U.S. Army Artifacts</cite>
  </h2>

  <p>
    Forgey, Sarah G., General Editor. Contributions by Alan T. Bogan,
    Carrie M. Gabaree, Paul M. Miller, and Brian F. Neumann,
    United States Army Center of Military History, 2018.
  </p>

  <div class="publication-media-actions">

    <div class="publication-media-item">
      <a href="/portfolio/armypubs/cmhPub_70-128.pdf" target="_blank" rel="noopener noreferrer" aria-label="View The Great War: U.S. Army Artifacts publication">
        <img src="/media/cmhPub_70-128-cover-200x150.webp" alt="Cover of The Great War: U.S. Army Artifacts" width="200" height="150" loading="lazy" />
      </a>

      <a class="button button-secondary" href="/portfolio/armypubs/cmhPub_70-128.pdf" target="_blank" rel="noopener noreferrer">
        View publication
      </a>
    </div>

<div class="publication-media-item">
  <a href="/portfolio/citations/cmhpub70-128" aria-label="View citation information for The Great War: U.S. Army Artifacts">
    <img src="/media/publication-citation-200x150.webp" alt="Citation document icon" width="200" height="150" loading="lazy" />
  </a>

  <a class="button button-secondary" href="/portfolio/citations/cmhpub70-128">
    Cite publication
  </a>
</div>

  </div>

</ContentCard>


<ContentCard class="content-card" id="body-armor">

  <p class="publication-meta">
    Army History · No. 106 · Winter 2018
  </p>

  <h2>
    “Protecting the Doughboys: The Development of American Body Armor During
    World War I”
  </h2>

  <p>
    Carrie Gabaree. <cite>Army History</cite>, no. 106, Winter 2018,
    pp. 30–31.
  </p>

  <div class="publication-media-actions">

    <div class="publication-media-item">
      <a href="/portfolio/armypubs/AH106W.pdf" target="_blank" rel="noopener noreferrer" aria-label="View Army History No. 106 full issue">
        <img src="/media/AH106W-cover-200x257.webp" alt="Cover of Army History, No. 106, Winter 2018" width="200" height="257" loading="lazy" />
      </a>

      <a class="button button-secondary" href="/portfolio/armypubs/AH106W.pdf" target="_blank" rel="noopener noreferrer">
        View full issue
      </a>
    </div>

    <div class="publication-media-item">
      <a href="/portfolio/armypubs/AH106Wpp30-31.pdf" target="_blank" rel="noopener noreferrer" aria-label="Read Protecting the Doughboys article">
        <img src="/media/AH106W-p30-200x257.webp" alt="First page of Protecting the Doughboys: The Development of American Body Armor During World War I" width="200" height="257" loading="lazy" />
      </a>

      <a class="button button-secondary" href="/portfolio/armypubs/AH106Wpp30-31.pdf" target="_blank" rel="noopener noreferrer">
        Read article
