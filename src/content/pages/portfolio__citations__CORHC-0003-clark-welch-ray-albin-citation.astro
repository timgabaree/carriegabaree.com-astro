---
import PageHeader from '../../components/PageHeader.astro';
import CitationCard from '../../components/CitationCard.astro';
---
<article class="page-panel citation-page">
  <PageHeader class="page-header">
    <p class="eyebrow">Oral History Citation</p>
    <h1>Clark Welch &amp; Ray Albin Oral History</h1>
    <p class="page-intro">
      Citation information for the oral-history interview with
      Clark Welch and Ray Albin, conducted by Carrie Gabaree (Tarasuk)
      with Andrew Woods
      at First Division Museum at Cantigny, Wheaton, Illinois on October 1, 2008.
    </p>
  </PageHeader>

  <section class="citation-summary">
    <p class="publication-meta">
      Oral history · CORHC-0003 · October 1, 2008 · Runtime: 2:30:07
    </p>
    <p>
      <strong>Interviewees:</strong> Clark Welch and Ray Albin<br />
      <strong>Interviewer:</strong> Carrie Gabaree (Tarasuk)<br />
      <strong>Additional participant:</strong> Andrew Woods<br />
      <strong>Repository:</strong> Carrie Gabaree Digital Archive
    </p>
  </section>

  <div class="citation-list">

    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>Chicago</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="corhc-0003-chicago"> Copy citation </button>
      </div>
      <p id="corhc-0003-chicago" class="citation-text">
        Welch, Clark, and Ray Albin. Interview by Carrie Gabaree (Tarasuk). October 1, 2008. CORHC-0003, Carrie Gabaree Digital Archive. https://carriegabaree.com/portfolio/oralhistories/CORHC-0003-clark-welch-ray-albin.html.
      </p>
    </CitationCard>

    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>MLA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="corhc-0003-mla"> Copy citation </button>
      </div>
      <p id="corhc-0003-mla" class="citation-text">
        Welch, Clark, and Ray Albin. Interview by Carrie Gabaree (Tarasuk). <cite>Carrie Gabaree Digital Archive</cite>, October 1, 2008, https://carriegabaree.com/portfolio/oralhistories/CORHC-0003-clark-welch-ray-albin.html.
      </p>
    </CitationCard>

    <CitationCard class="citation-card">
      <div class="citation-card-header">
        <h2>APA</h2>
        <button class="citation-copy"
                type="button"
                data-copy-target="corhc-0003-apa"> Copy citation </button>
      </div>
      <p id="corhc-0003-apa" class="citation-text">
        Welch, C., &amp; Albin, R. (2008, October 1). <cite>Clark Welch &amp; Ray Albin Oral History</cite> [Oral history interview by Carrie Gabaree (Tarasuk)]. Carrie Gabaree Digital Archive. https://carriegabaree.com/portfolio/oralhistories/CORHC-0003-clark-welch-ray-albin.html
      </p>
    </CitationCard>

  </div>

  <aside class="citation-note">
    <h2>Oral-history citation note</h2>
    <p>
      Oral-history citation practices vary by style guide and institution.
      These citations identify the interviewee or interviewees, interviewer,
      interview date, archival identifier, repository, and stable interview
      page so researchers can locate the audiovisual recording and transcript.
    </p>
  </aside>

  <div class="button-group citation-actions">
    <a class="button button-primary" href="/portfolio/oralhistories/CORHC-0003-clark-welch-ray-albin">
      View oral history
    </a>
    <a class="button button-secondary" href="/portfolio/oralhistories/CORHC-0003-clark-welch-ray-albin-transcript">
      Read transcript
    </a>
    <a class="button button-secondary" href="/oral-histories">
      Back to oral histories
    </a>
  </div>

  <p class="citation-disclaimer">
    Citations are provided for convenience. Requirements may vary by
    institution, publisher, instructor, repository, or edition of a style guide.
  </p>
</article>
