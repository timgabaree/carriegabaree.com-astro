---
import site from '../data/site.json';
interface Props {title:string;description:string;path:string;ogType?:string;noindex?:boolean;schema?:object[];}
const {title,description,path,ogType='website',noindex=false,schema=[]}=Astro.props;
const production=import.meta.env.PUBLIC_SITE_ENV==='production';
const canonical=site.url+path;
---
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#111111" /><title>{title}</title><meta name="description" content={description} /><meta name="author" content={site.name} /><meta name="robots" content={!production||noindex?'noindex, nofollow, noarchive':'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
{path!='/404'&&<link rel="canonical" href={canonical} />}<link rel="me" href="https://www.linkedin.com/in/carriegabaree" /><link rel="icon" href="/favicon.ico" /><link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" /><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta property="og:locale" content="en_US" /><meta property="og:type" content={ogType} /><meta property="og:site_name" content={site.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={site.url+site.image} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="1200" /><meta property="og:image:alt" content="Carrie Gabaree, museum curator and public historian" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={site.url+site.image} />
{schema.map(data=><script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g,'\\u003c')} />)}
