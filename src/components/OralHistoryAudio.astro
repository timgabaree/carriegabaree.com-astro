---
interface Props { src: string; label: string; download: string }
const { src, label, download } = Astro.props;
---
<div class="oral-history-player" data-audio-player>
  <audio class="oral-history-audio" controls preload="metadata" aria-label={label}>
    <source src={src} type="audio/mpeg" />
    Your browser does not support the audio player.
  </audio>
  <div class="audio-skip-controls" role="group" aria-label="Skip through recording" hidden>
    <button type="button" class="button button-secondary" data-skip="-10" disabled>
      <span aria-hidden="true">↶</span> Back 10 seconds
    </button>
    <button type="button" class="button button-secondary" data-skip="10" disabled>
      Forward 10 seconds <span aria-hidden="true">↷</span>
    </button>
  </div>
  <div class="audio-download-controls">
    <a class="button button-secondary" href={download} download>Download MP3</a>
  </div>
</div>
<script is:inline src="/js/oral-history-audio.js" defer></script>
<style>
  .oral-history-player { width: 100%; }
  .audio-skip-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 0.75rem; }
  .audio-skip-controls[hidden] { display: none; }
  .audio-skip-controls button, .audio-download-controls .button { box-sizing: border-box; width: 210px; max-width: 100%; text-align: center; line-height: 1.5; height: 48px; margin: 0; padding: 0.65rem 0.85rem; border: 1px solid transparent; gap: 0.4rem; font-family: inherit; font-size: 1rem; font-weight: 400; white-space: nowrap; cursor: pointer; }
  .audio-download-controls { display: flex; justify-content: center; margin-top: 0.5rem; }
  .audio-skip-controls button:disabled { opacity: 0.5; cursor: default; }
</style>
