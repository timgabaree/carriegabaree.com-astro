{
  "name": "carriegabaree.com-astro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "astro check && tsc -p worker/tsconfig.json",
    "dev": "astro dev",
    "build": "astro build",
    "build:staging": "PUBLIC_SITE_ENV=staging npm run build",
    "build:production": "PUBLIC_SITE_ENV=production npm run build",
    "preview": "wrangler dev --ip 127.0.0.1 --var ENVIRONMENT:local",
    "test": "node --test tests/*.test.mjs",
    "test:site": "node scripts/verify-site.mjs",
    "deploy:staging": "npm run check && npm test && npm run build:staging && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "svix": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261027.1",
    "lightningcss": "1.33.0",
    "node-html-parser": "^9.0.5",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
