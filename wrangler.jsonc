{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carriegabaree-com-astro-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "CONTACT_MODE": "resend"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACT_STATE",
        "class_name": "ContactState"
      },
      {
        "name": "DELIVERY_STATUS",
        "class_name": "DeliveryStatus",
        "script_name": "family-sites-email-monitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ContactState"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "account_id": "7459bd2037d71d23fd030e3542b9df61",
  "routes": []
}
